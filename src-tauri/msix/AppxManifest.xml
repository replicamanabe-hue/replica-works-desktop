<?xml version="1.0" encoding="utf-8"?>
<!--
  Microsoft Store 提出用の MSIX マニフェスト。
  Identity の Name / Publisher は Partner Center の「製品 ID」ページに出る値と一致させる必要があり、
  GitHub の変数 MSIX_IDENTITY_NAME / MSIX_PUBLISHER から scripts/make-msix.ps1 が埋める。
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">
  <Identity Name="__IDENTITY_NAME__" Publisher="__PUBLISHER__" Version="__VERSION__" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Replica Works</DisplayName>
    <PublisherDisplayName>__PUBLISHER_DISPLAY_NAME__</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>合同会社Replica の案件・契約・書類・進捗を扱う Replica Works と、お客様ページのデスクトップ版</Description>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>
  <Resources>
    <Resource Language="ja-JP" />
    <Resource Language="en-US" />
  </Resources>
  <Applications>
    <Application Id="ReplicaWorks" Executable="ReplicaWorks.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Replica Works"
        Description="Replica Works と、お客様ページのデスクトップ版"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" Square310x310Logo="Assets\Square310x310Logo.png" ShortName="Replica Works" />
      </uap:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
